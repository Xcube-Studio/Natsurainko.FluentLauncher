<Page
    x:Class="Natsurainko.FluentLauncher.Views.Instances.ResourcePackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Natsurainko.FluentLauncher.Xaml.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Natsurainko.FluentLauncher.Models.UI"
    xmlns:toolkit_behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:vm="using:Natsurainko.FluentLauncher.ViewModels.Instances"
    xmlns:xh="using:Natsurainko.FluentLauncher.Xaml"
    x:Name="Page"
    AllowDrop="True"
    DragEnter="Page_DragEnter"
    Drop="Page_Drop"
    mc:Ignorable="d">

    <ListView
        x:Name="ListView"
        Padding="40,0,40,25"
        ItemsSource="{x:Bind VM.ResourcePacks, Mode=OneWay}"
        SelectionMode="None">
        <ListView.Header>
            <StackPanel MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>
                <i:Interaction.Behaviors>
                    <toolkit_behaviors:FadeHeaderBehavior />
                </i:Interaction.Behaviors>

                <controls:SettingsCard
                    ActionIcon="{xh:FontIcon Glyph=&#xED43;}"
                    Command="{x:Bind VM.OpenResourcePacksFolderCommand}"
                    Description="{x:Bind VM.ResourcePacksFolder, Mode=OneWay}"
                    Header="Resource Packs Folder"
                    HeaderIcon="{xh:FontIcon Glyph=&#xED43;}"
                    IsClickEnabled="True" />

                <TextBlock
                    Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Resource Packs" />

                <StackPanel
                    Margin="0,60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="32" Glyph="&#xE91B;" />
                        <TextBlock
                            Margin="0,-4,0,0"
                            FontSize="28"
                            Style="{ThemeResource BaseTextBlockStyle}"
                            Text="No Resource Packs" />
                    </StackPanel>
                    <HyperlinkButton
                        Padding="5,0,5,0.5"
                        HorizontalAlignment="Center"
                        Command="{x:Bind VM.InstallResourcePacksCommand}">
                        <TextBlock Text="Download Resource Packs" />
                    </HyperlinkButton>

                    <i:Interaction.Behaviors>
                        <behaviors:EmptyListVisibleBehavior IsObservableCollection="True" ItemsSource="{x:Bind VM.ResourcePacks, Mode=OneWay}" />
                    </i:Interaction.Behaviors>
                </StackPanel>
            </StackPanel>
        </ListView.Header>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:ResourcePackItem">
                <controls:SettingsCard
                    Padding="16,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsActionIconVisible="False"
                    IsClickEnabled="False">
                    <controls:SettingsCard.Header>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                BorderBrush="{ThemeResource IconBorder}"
                                BorderThickness="2"
                                CornerRadius="4">
                                <Border CornerRadius="4">
                                    <Image>
                                        <i:Interaction.Behaviors>
                                            <behaviors:ImageSourceLoadBehavior ImageSourceFilePath="{x:Bind IconFilePath}" SourcePropertyName="Source" />
                                        </i:Interaction.Behaviors>
                                    </Image>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                                    MaxLines="2"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.ContextFlyout>
                        <MenuFlyout Opened="MenuFlyout_Opened" Placement="Bottom">
                            <MenuFlyoutItem
                                Tag="Open"
                                CommandParameter="{x:Bind}"
                                Text="Show in Explorer">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEC51;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Tag="CheckUpdate"
                                CommandParameter="{x:Bind}"
                                Text="Check for Updates">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE895;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Tag="Delete"
                                CommandParameter="{x:Bind}"
                                Icon="Delete"
                                Text="Delete" />
                        </MenuFlyout>
                    </controls:SettingsCard.ContextFlyout>
                    <ToggleSwitch Toggled="ToggleSwitch_Toggled" IsOn="{x:Bind IsEnabled, Mode=OneWay}" />
                </controls:SettingsCard>
            </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MaxWidth" Value="1000" />
            </Style>
        </ListView.ItemContainerStyle>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger>
                            <AdaptiveTrigger.MinWindowWidth>
                                <x:Double>641</x:Double>
                            </AdaptiveTrigger.MinWindowWidth>
                        </AdaptiveTrigger>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListView.Padding" Value="20,0,20,20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ListView>
</Page>
